apiVersion: batch/v1
kind: Job
metadata:
  name: {{ bikehub_migration_job_name }}
  namespace: {{ bikehub_namespace }}
  labels:
    app.kubernetes.io/name: bikehub-db-migrate
spec:
  backoffLimit: 1
  activeDeadlineSeconds: {{ bikehub_migration_timeout }}
  ttlSecondsAfterFinished: {{ bikehub_migration_retention }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: bikehub-db-migrate
    spec:
      restartPolicy: Never
      containers:
        - name: migrate
          image: {{ bikehub_selected_image }}
          imagePullPolicy: Never
          args:
            - --migrate-only
          env:
            - name: Database__Schema
              value: {{ bikehub_database_schema | default('public') | to_json }}
            - name: Database__BootstrapEnabled
              value: {{ bikehub_database_bootstrap_enabled | bool | ternary('true', 'false') | to_json }}
            - name: Database__MigrationsEnabled
              value: "true"
            - name: ConnectionStrings__BikeHub
              valueFrom:
                secretKeyRef:
                  name: bikehub-database
                  key: connection-string
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              cpu: "1"
              memory: 512Mi
