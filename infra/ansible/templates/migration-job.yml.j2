apiVersion: batch/v1
kind: Job
metadata:
  name: bikehub-db-migrate-{{ ansible_facts.date_time.epoch }}
  namespace: {{ bikehub_namespace }}
  labels:
    app.kubernetes.io/name: bikehub-db-migrate
spec:
  backoffLimit: 1
  ttlSecondsAfterFinished: 600
  template:
    metadata:
      labels:
        app.kubernetes.io/name: bikehub-db-migrate
    spec:
      restartPolicy: Never
      containers:
        - name: migrate
          image: {{ bikehub_image }}
          imagePullPolicy: Never
          args:
            - --migrate-only
          env:
            - name: Database__BootstrapEnabled
              value: "false"
            - name: Database__MigrationsEnabled
              value: "true"
            - name: ConnectionStrings__BikeHub
              valueFrom:
                secretKeyRef:
                  name: bikehub-database
                  key: connection-string
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              cpu: "1"
              memory: 512Mi
