upstream bikehub_staging_api {
    server {{ ansible_facts.default_ipv4.address }}:{{ bikehub_staging_node_port }};
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name {{ bikehub_staging_hostname }};
    return 308 https://{{ bikehub_staging_hostname }}$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{ bikehub_staging_hostname }};
    ssl_certificate /etc/nginx/{{ bikehub_staging_prefix }}-tls/{{ bikehub_staging_prefix }}_tls.pub;
    ssl_certificate_key /etc/nginx/{{ bikehub_staging_prefix }}-tls/{{ bikehub_staging_prefix }}_tls;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:BikeHubStagingTLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    location = /mailpit { return 308 /mailpit/; }
    location /mailpit/ {
        proxy_pass http://{{ ansible_facts.default_ipv4.address }}:{{ bikehub_staging_mailpit_node_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location / {
        proxy_pass http://bikehub_staging_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
