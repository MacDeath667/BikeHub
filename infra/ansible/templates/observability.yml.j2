apiVersion: v1
kind: Namespace
metadata:
  name: {{ bikehub_observability_namespace }}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: bikehub-observability
  namespace: {{ bikehub_observability_namespace }}
data:
{% for component in bikehub_observability_components %}
  {{ component.name }}.yml: |
{{ lookup('ansible.builtin.file', bikehub_observability_config_directory ~ '/' ~ component.config) | indent(4, true) }}
{% endfor %}
{% for component in bikehub_observability_components %}
{% if component.storage is defined %}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ component.name }}-data
  namespace: {{ bikehub_observability_namespace }}
spec:
  accessModes: [ReadWriteOnce]
  storageClassName: local-path
  resources:
    requests:
      storage: {{ component.storage }}
{% endif %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ component.name }}
  namespace: {{ bikehub_observability_namespace }}
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: bikehub-{{ component.name }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: bikehub-{{ component.name }}
      annotations:
        checksum/config: {{ lookup('ansible.builtin.file', bikehub_observability_config_directory ~ '/' ~ component.config) | hash('sha256') }}
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: {{ component.user }}
        runAsGroup: {{ component.user }}
        fsGroup: {{ component.user }}
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: {{ component.name }}
          image: {{ component.image }}
          args: {{ component.args | to_json }}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
          ports:
{% for port in component.ports %}
            - name: {{ port.name }}
              containerPort: {{ port.port }}
{% endfor %}
          volumeMounts:
            - name: config
              mountPath: /etc/bikehub
              readOnly: true
            - name: tmp
              mountPath: /tmp
{% if component.data_path is defined %}
            - name: data
              mountPath: {{ component.data_path }}
{% endif %}
          startupProbe:
            httpGet:
              port: {{ component.readiness.port }}
              path: {{ component.readiness.path }}
            periodSeconds: 5
            failureThreshold: 60
          readinessProbe:
            httpGet:
              port: {{ component.readiness.port }}
              path: {{ component.readiness.path }}
            periodSeconds: 5
          resources:
            requests:
              cpu: 50m
              memory: {{ component.memory_request }}
            limits:
              cpu: "1"
              memory: {{ component.memory_limit }}
      volumes:
        - name: config
          configMap:
            name: bikehub-observability
        - name: tmp
          emptyDir:
            sizeLimit: 64Mi
{% if component.storage is defined %}
        - name: data
          persistentVolumeClaim:
            claimName: {{ component.name }}-data
{% endif %}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ component.name }}
  namespace: {{ bikehub_observability_namespace }}
spec:
  selector:
    app.kubernetes.io/name: bikehub-{{ component.name }}
  ports:
{% for port in component.ports %}
    - name: {{ port.name }}
      port: {{ port.port }}
      targetPort: {{ port.name }}
{% endfor %}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ component.name }}-external
  namespace: {{ bikehub_observability_namespace }}
spec:
  type: NodePort
  selector:
    app.kubernetes.io/name: bikehub-{{ component.name }}
  ports:
    - name: http
      port: {{ component.external_port }}
      targetPort: {{ component.external_port }}
      nodePort: {{ component.node_port }}
{% endfor %}
