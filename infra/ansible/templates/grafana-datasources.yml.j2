apiVersion: 1
datasources:
  - uid: bikehub-prometheus
    name: BikeHub Prometheus
    type: prometheus
    access: proxy
    url: http://{{ ansible_facts.default_ipv4.address }}:{{ bikehub_prometheus_node_port }}
    editable: false
    jsonData:
      httpMethod: POST
      timeInterval: 15s
      exemplarTraceIdDestinations:
        - { name: trace_id, datasourceUid: bikehub-tempo }
  - uid: bikehub-loki
    name: BikeHub Loki
    type: loki
    access: proxy
    url: http://{{ ansible_facts.default_ipv4.address }}:{{ bikehub_loki_node_port }}
    editable: false
    jsonData:
      derivedFields:
        - name: TraceID
          matcherRegex: trace_id
          matcherType: label
          datasourceUid: bikehub-tempo
          url: "$${__value.raw}"
          urlDisplayLabel: View trace
  - uid: bikehub-tempo
    name: BikeHub Tempo
    type: tempo
    access: proxy
    url: http://{{ ansible_facts.default_ipv4.address }}:{{ bikehub_tempo_node_port }}
    editable: false
    jsonData:
      tracesToLogsV2:
        datasourceUid: bikehub-loki
        spanStartTimeShift: -1m
        spanEndTimeShift: 1m
        tags:
          - { key: service.name, value: service_name }
        customQuery: true
        query: '{$$__tags} | trace_id = "$${__trace.traceId}"'
      nodeGraph:
        enabled: true
