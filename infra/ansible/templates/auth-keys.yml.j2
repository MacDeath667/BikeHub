apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ bikehub_auth_key_claim }}
  namespace: {{ bikehub_namespace }}
spec:
  accessModes: [ReadWriteOnce]
  storageClassName: local-path
  resources:
    requests:
      storage: 1Gi

---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ bikehub_auth_key_claim }}-media
  namespace: {{ bikehub_namespace }}
spec:
  accessModes: [ReadWriteOnce]
  storageClassName: local-path
  resources:
    requests:
      storage: 10Gi
