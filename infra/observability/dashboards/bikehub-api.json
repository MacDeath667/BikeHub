      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (deployment_environment_name) (dotnet_process_memory_working_set_bytes{service_name=\"bikehub-api\",deployment_environment_name=~\"$environment\"})",
          "range": true,
          "legendFormat": "{{deployment_environment_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
