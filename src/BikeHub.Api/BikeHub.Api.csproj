<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <UserSecretsId>59cf445c-5411-4fbc-aa9e-d24549fe46b1</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
      <Content Include="..\..\..\BikeHub\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\BikeHub.Application\BikeHub.Application.csproj" />
      <ProjectReference Include="..\BikeHub.Dal\BikeHub.Dal.csproj" />
      <ProjectReference Include="..\BikeHub.Domain\BikeHub.Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Google.Apis.Gmail.v1" Version="1.77.0.4295" />
      <PackageReference Include="MailKit" Version="4.18.2" />
      <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
      <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
      <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
      <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
      <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    </ItemGroup>

</Project>
